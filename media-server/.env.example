# Shared secret — must match on Ubuntu media-server and Vercel/Next
MEDIA_API_SECRET=change-me-to-a-long-random-string

# Ubuntu media server (no trailing slash)
MEDIA_API_URL=https://media.example.com
PORT=4050
MEDIA_ROOT=./songs
PUBLIC_BASE_URL=https://media.example.com

# Allow your Vercel site to upload from the browser
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# On Vercel only: Blob store for room/queue state (not songs)
# BLOB_READ_WRITE_TOKEN=
