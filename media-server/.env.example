# Shared secret — must match on media-server and Vercel/Next
MEDIA_API_SECRET=change-me-to-a-long-random-string

PORT=4050
MEDIA_ROOT=./songs

# After `ngrok http 4050`, paste the HTTPS URL here (no trailing slash)
PUBLIC_BASE_URL=https://YOUR-SUBDOMAIN.ngrok-free.app

# Allow browser uploads from the web app
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:3000

# Rooms + songs are stored under MEDIA_ROOT on this machine (Ubuntu).
# No Vercel Blob needed.
